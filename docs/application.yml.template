# =============================================
# application.yml 配置模板
# 复制到 backend/src/main/resources/application.yml 并修改
# =============================================

server:
  port: 8080

spring:
  application:
    name: novel-ai-writer
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/novel_ai_writer?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root          # 修改为你的 MySQL 用户名
    password: 123456789 # 修改为你的 MySQL 密码
  data:
    redis:
      host: localhost       # Redis 地址
      port: 6379
      password:             # Redis 密码（无密码留空）
      database: 0
      timeout: 3000ms
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai
    default-property-inclusion: non_null

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT 配置
jwt:
  secret: novel-ai-writer-jwt-secret-key-change-in-production-2024  # 生产环境务必更换
  expiration: 86400000  # Token 有效期（毫秒），默认 24 小时

# 大模型 API 配置（密钥仅在后端，前端不可见）
llm:
  api-url: https://api.openai.com/v1/chat/completions  # 兼容 OpenAI 格式的 API 地址
  api-key: sk-your-api-key-here                        # 替换为你的 API Key
  model: gpt-4o-mini
  max-tokens: 4096
  temperature: 0.8

# 异步线程池
async:
  core-pool-size: 4
  max-pool-size: 8
  queue-capacity: 100
  thread-name-prefix: novel-async-

# 接口限流（每用户每分钟最大请求数）
rate-limit:
  enabled: true
  max-requests: 60
  window-seconds: 60
